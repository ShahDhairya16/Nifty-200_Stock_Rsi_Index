# MongoDB Database Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=cnx200_rsi_dashboard

# Historical Ingestion Settings (Format: YYYY-MM-DD or empty for default 1 year)
HISTORICAL_START_DATE=
HISTORICAL_END_DATE=

# NSE API Retry Settings
NSE_MAX_RETRIES=3
NSE_RETRY_MIN_WAIT=2
NSE_RETRY_MAX_WAIT=10

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Google Gemini AI (chatbot + purchase recommendations)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-flash-latest,gemini-2.5-flash
GEMINI_TEMPERATURE=0.3

# NIFTY 200 universe auto-check cadence (hours). NSE rebalances in March and
# September; the dashboard checks for any change at most once per interval.
UNIVERSE_CHECK_INTERVAL_HOURS=24

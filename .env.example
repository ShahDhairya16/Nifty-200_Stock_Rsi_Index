# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cnx200_rsi_dashboard
DB_USER=root
DB_PASSWORD=

# Historical Ingestion Settings (Format: YYYY-MM-DD or empty for default 1 year)
HISTORICAL_START_DATE=
HISTORICAL_END_DATE=

# NSE API Retry Settings
NSE_MAX_RETRIES=3
NSE_RETRY_MIN_WAIT=2
NSE_RETRY_MAX_WAIT=10

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
